# Optional: enables the Claude counsellor. Without it the app runs the guided voice interview.
ANTHROPIC_API_KEY=
# Hub settings
PORT=8787
HUB_NAME=Hunar Setu Hub - Vellore
# Comma-separated keys for employers/NGOs posting via /api/partners/opportunities
PARTNER_KEYS=demo-partner-key
# Formal accounts (register / login). Without it the hub still works offline; sign-up is just unavailable.
DATABASE_URL=postgres://hunar_setu:CHANGE_ME@localhost:5432/hunar_setu
# Only for `npm test`: a throwaway database the account tests may wipe.
TEST_DATABASE_URL=postgres://hunar_setu:CHANGE_ME@localhost:5432/hunar_setu_test
# Live job search for "Near me" (each optional; free keys)
#   https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
#   https://in.jooble.org/api/about
JOOBLE_API_KEY=
